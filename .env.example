# Copy to .env and fill in. The pipeline runs WITHOUT any of these (heuristic fallback),
# but real drafts need one LLM provider.

# --- LLM provider (pick ONE; leave blank to use the free heuristic fallback) ---
LLM_PROVIDER=groq            # groq | anthropic | openai | heuristic
LLM_API_KEY=                 # your key for the chosen provider
LLM_MODEL=                   # optional override, e.g. llama-3.3-70b-versatile

# --- Optional delivery (added later) ---
SLACK_WEBHOOK_URL=
