# Copy to deploy/.env.prod on the server and fill in real values.
# deploy/.env.prod is gitignored — never commit real secrets.
#   cp deploy/.env.prod.example deploy/.env.prod

# Postgres password for the app's database (make it long + random).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Resend SMTP. Username is literally "resend"; password is your Resend API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_resend_api_key_here
SMTP_FROM_NAME=Coldstart
SMTP_FROM_ADDRESS=noreply@getcoldstart.nl

# Admin mailbox (IMAP/SMTP inbox view). Optional — leave blank to soft-degrade:
# the app still starts and the admin mailbox panel shows "Mailbox unreachable"
# until these are set.
MAILBOX_HOST=
MAILBOX_USERNAME=
MAILBOX_PASSWORD=

# "Polish with AI" on the company profile page (Groq). Optional — leave blank to
# soft-degrade: the button shows "Couldn't polish just now" until this is set.
LLM_API_KEY=

# Stripe billing (LIVE keys — sk_live_..., whsec_... from the dashboard webhook
# endpoint, and the two live price ids). Optional — leave blank to soft-degrade:
# checkout/portal show a notice and the webhook rejects all posts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY_ID=
STRIPE_PRICE_SETUP_ID=

# Branded "Send from Coldstart" outreach mailbox (admin-only send). Optional.
OUTREACH_HOST=
OUTREACH_USERNAME=
OUTREACH_PASSWORD=

# Nightly pg_dump retention (days) for the db-backup sidecar. Dumps land in
# ./backups on the host — copy them off the server for real disaster recovery.
BACKUP_RETENTION_DAYS=14

# Admin API key for /api/admin/* (the coldstart CLI). Long + random, e.g.:
#   openssl rand -base64 32
# Leave blank to disable the admin API entirely (routes return 404).
ADMIN_API_KEY=
