# Automatic HTTPS via Let's Encrypt. Requires the domain's A record to point at
# this server and ports 80/443 open. Everything is served by the one web app.
#
# Upstreams are addressed by CONTAINER NAME, not by compose service name. This
# host also runs PurePrep, whose stack joins this network and declares a service
# called "web" too — so the bare alias "web" resolves to whichever of the two
# Docker's DNS feels like returning, and Coldstart traffic silently lands on
# PurePrep's API (which 404s every route). Container names are unique per host.
getcoldstart.nl {
	reverse_proxy coldstart-web-1:8080
}

# Send www to the bare domain.
www.getcoldstart.nl {
	redir https://getcoldstart.nl{uri} permanent
}

# Self-hosted, cookieless analytics (Umami) — first-party on our own box.
stats.getcoldstart.nl {
	reverse_proxy umami:3000
}

# PurePrep AI backend (separate /opt/pureprep stack, joined on this network).
# Kept here because this Caddy is the only ingress on the box: if this block is
# missing after a redeploy, PurePrep loses TLS and routing entirely.
api.pureprep.lechdigital.nl {
	reverse_proxy pureprep-web:8080
}
