@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>@ViewData["Title"]</title>
<meta name="description" content="Coldstart finds companies that need what you sell — the morning it becomes true — and writes your first email to them. You read it over coffee and hit approve. Done-for-you, €750/month.">
<link rel="icon" href="~/favicon.svg" type="image/svg+xml">
<link rel="manifest" href="~/site.webmanifest">
<meta name="theme-color" content="#16192B">
<meta name="apple-mobile-web-app-title" content="Coldstart">
<meta property="og:title" content="Coldstart — wake up to your next client, already found">
<meta property="og:description" content="We watch the market overnight, pick the few companies that need you right now, and draft your opening email. You approve.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://getcoldstart.nl@(Context.Request.Path)">
<meta property="og:image" content="https://getcoldstart.nl/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Coldstart — wake up to your next client. Qualified B2B leads with ready-to-send drafts, every morning.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://getcoldstart.nl/og.png">
<link rel="preload" href="~/fonts/CabinetGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="~/fonts/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
@{
    var analyticsId = Configuration["Analytics:WebsiteId"];
    var isPublic = !Context.Request.Path.StartsWithSegments("/app") && !Context.Request.Path.StartsWithSegments("/admin") && !Context.Request.Path.StartsWithSegments("/Identity");
    // The footer renders outside the rail shell, so on portal pages it needs the
    // rail's offset itself — otherwise the fixed rail covers its left edge.
    var footerClass = isPublic ? "" : "rail-footer";
}
@if (isPublic && !string.IsNullOrEmpty(analyticsId))
{
    <script defer src="@Configuration["Analytics:ScriptUrl"]" data-website-id="@analyticsId"></script>
}
</head>
<body>

@RenderBody()

@* The footer renders outside .rail-shell, so on the two areas that use the rail it
   needs the rail's own offset — otherwise the fixed rail covers its left edge.
   /Identity pages have no rail, so they are deliberately excluded. *@
<div class="@(Context.Request.Path.StartsWithSegments("/app") || Context.Request.Path.StartsWithSegments("/admin") ? "rail-footer" : null)"><partial name="_Footer" /></div>

<script src="~/js/contact.js" defer asp-append-version="true"></script>
</body>
</html>
