@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy";
    Layout = "_Layout";
}

<main>
<header class="hero">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Legal</p>
      <h1>Privacy Policy</h1>
      <p><strong>Draft — pending review, not legal advice.</strong> This is a starter policy while Coldstart finalizes its legal details.</p>
    </div>
  </div>
</header>

<section>
  <div class="wrap">
    <div class="section-head">
      <h2>Who we are</h2>
      <p>Coldstart is based in Schiedam, Netherlands. KvK: <em>[to be added]</em>. VAT: <em>[to be added]</em>.</p>
    </div>

    <div class="section-head">
      <h2>What we collect</h2>
      <ul class="checklist">
        <li>Contact-form inquiries: name, email, niche, what you sell, and an optional message</li>
        <li>Your account email</li>
        <li>Authentication cookies needed to keep you signed in</li>
      </ul>
    </div>

    <div class="section-head">
      <h2>Why</h2>
      <p>We use this information to respond to your inquiries and to provide the Coldstart service.</p>
    </div>

    <div class="section-head">
      <h2>Retention</h2>
      <p>We keep your data until you ask us to delete it.</p>
    </div>

    <div class="section-head">
      <h2>Your rights</h2>
      <p>You can request access to or deletion of your data at any time by emailing us.</p>
    </div>

    <div class="section-head">
      <h2>Contact</h2>
      <p>Questions about this policy? Email <a href="mailto:andrzej.lech.andrzej@gmail.com">andrzej.lech.andrzej@gmail.com</a>.</p>
    </div>
  </div>
</section>
</main>
