@page "/admin"
@model Coldstart.Web.Areas.Admin.Pages.IndexModel
@using Coldstart.Domain
@{ ViewData["Title"] = "Admin · Companies"; Layout = "/Pages/Shared/_Layout.cshtml"; ViewData["AdminTab"] = "companies"; }

<div class="rail-shell">
  <partial name="_AdminSidebar" />
  <div class="rail-main">
<main class="wrap app-zone">
  <div class="pz-head">
    <div>
      <h1>Companies</h1>
      <p class="pz-sub">Invite a new company, or open one below to manage its people, plan and harvest.</p>
    </div>
    <span class="pz-count">@Model.Rows.Count compan@(Model.Rows.Count == 1 ? "y" : "ies")</span>
  </div>

  @if (Model.StatusMessage is not null) { <p class="form-status">@Model.StatusMessage</p> }

  <div class="pz-card">
    <h2>Invite a company</h2>
    <form method="post" asp-page-handler="Invite">
      <div asp-validation-summary="All" class="field-error"></div>
      <div class="pz-field"><label asp-for="Input.Company">Company name</label><input asp-for="Input.Company" required></div>
      <div class="pz-field"><label asp-for="Input.Email">Admin email</label><input asp-for="Input.Email" type="email" required></div>
      <div class="pz-field"><label asp-for="Input.Niche">Who their customers are (niche)</label><input asp-for="Input.Niche" required placeholder="e.g. dental clinics in the Benelux"></div>
      <div class="pz-field"><label asp-for="Input.Info">What they sell / notes</label><textarea asp-for="Input.Info" rows="3" placeholder="from their inquiry, or a short description"></textarea></div>
      <div class="pz-actions"><button class="pz-btn pz-btn-primary" type="submit">Send invite</button></div>
    </form>
  </div>

  <div class="pz-card">
    <h2>Inquiries</h2>
    @* Nothing here is ever deleted — an inquiry carries a GDPR consent timestamp, so dismissing
       only hides it from the open queue and restoring brings it straight back. Converted is
       derived (a user account already exists for the email), never stored, so it can't drift. *@
    <div class="pz-row-actions">
      <a class="pz-btn @(Model.Filter == "open" ? "pz-btn-primary" : "pz-btn-quiet")" href="/admin?filter=open">Open · @Model.OpenCount</a>
      <a class="pz-btn @(Model.Filter == "converted" ? "pz-btn-primary" : "pz-btn-quiet")" href="/admin?filter=converted">Converted · @Model.ConvertedCount</a>
      <a class="pz-btn @(Model.Filter == "dismissed" ? "pz-btn-primary" : "pz-btn-quiet")" href="/admin?filter=dismissed">Dismissed · @Model.DismissedCount</a>
      <a class="pz-btn @(Model.Filter == "all" ? "pz-btn-primary" : "pz-btn-quiet")" href="/admin?filter=all">All · @Model.AllCount</a>
    </div>

    @if (Model.Inquiries.Count == 0)
    {
      <p class="pz-empty">
        @(Model.Filter switch
        {
          "converted" => "No converted inquiries yet — they'll show up here once an invited company signs in.",
          "dismissed" => "No dismissed inquiries — anything marked spam or not-a-fit will show up here.",
          "all" => "No inquiries yet — they'll appear here as visitors submit the contact form.",
          _ => "No open inquiries — you're caught up.",
        })
      </p>
    }
    else
    {
      <div class="pz-table-wrap">
        <table class="pz-table">
          <thead><tr><th>Name</th><th>Company</th><th class="pz-cell-wrap">Email</th><th>Niche</th><th>Sells</th><th>Status</th><th></th></tr></thead>
          <tbody>
          @foreach (var q in Model.Inquiries)
          {
            <tr>
              <td>@q.Name</td>
              <td>@(q.Company ?? "—")</td>
              <td class="pz-cell-wrap">@q.Email</td>
              <td>@q.Niche</td>
              <td>@q.WhatYouSell</td>
              <td>
                @if (q.Converted)
                {
                  <span class="pz-pill pz-pill-sent">Converted</span>
                  @if (q.ConvertedCustomerId is { } cid)
                  {
                    <span class="pz-cell-sub"><a href="/admin/customers/@cid">@(q.ConvertedCustomerName ?? "View company")</a></span>
                  }
                }
                else if (q.IsDismissed)
                {
                  <span class="pz-pill pz-pill-sent">Dismissed</span>
                  <span class="pz-cell-sub">@q.DismissedAt!.Value.ToString("d MMM")</span>
                }
                else
                {
                  <span class="pz-pill pz-pill-maybe">Open</span>
                }
              </td>
              <td>
                @if (q.Converted)
                {
                  @* Already resolved — no action to offer. *@
                }
                else if (q.IsDismissed)
                {
                  <form method="post" asp-page-handler="Restore">
                    <input type="hidden" name="id" value="@q.Id">
                    <input type="hidden" name="Filter" value="@Model.Filter">
                    <button class="pz-btn pz-btn-quiet" type="submit">Restore</button>
                  </form>
                }
                else
                {
                  <div class="pz-row-actions">
                    <a class="pz-btn pz-btn-quiet" href="/admin?useInquiry=@q.Id">Use for invite</a>
                    <form method="post" asp-page-handler="Dismiss">
                      <input type="hidden" name="id" value="@q.Id">
                      <input type="hidden" name="Filter" value="@Model.Filter">
                      @* Dismiss is reversible (Restore is one click away), so it deliberately
                         carries no confirmation — unlike genuinely destructive actions on this page. *@
                      <button class="pz-btn pz-btn-quiet" type="submit">Dismiss</button>
                    </form>
                  </div>
                }
              </td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </div>

  <div class="pz-card">
    <h2>All companies</h2>
    @if (Model.Rows.Count == 0)
    {
      <p class="pz-empty">No companies yet — invite one above.</p>
    }
    else
    {
      <div class="pz-table-wrap">
        <table class="pz-table">
          <thead><tr><th>Company</th><th>Plan</th><th>Harvest</th><th>Users</th><th>Leads</th><th></th></tr></thead>
          <tbody>
          @foreach (var r in Model.Rows)
          {
            <tr>
              <td><a class="pz-row-link" href="/admin/customers/@r.CustomerId">@r.Company</a></td>
              <td>
                @if (r.ComplimentaryUntil is { } compUntil)
                {
                  @* Comp grants are Plan==Full under the hood, but must read as their own state —
                     not indistinguishable from a real paying customer. *@
                  <span class="pz-pill pz-pill-maybe">Complimentary</span>
                  <span class="pz-cell-sub">until @compUntil.ToString("d MMM") · @Math.Max(0, (int)Math.Ceiling((compUntil - DateTimeOffset.UtcNow).TotalDays))d left</span>
                }
                else if (r.Plan == CustomerPlan.Full)
                {
                  <span class="pz-pill pz-pill-yes">Full</span>
                }
                else
                {
                  <span class="pz-pill pz-pill-sent">Free</span>
                }
              </td>
              <td>
                @r.HarvestStatus
                @if (r.LastHarvestAt is { } lastAt) { <span class="pz-cell-sub">@lastAt.ToString("d MMM HH:mm")</span> }
              </td>
              <td>@r.UserCount</td>
              <td>@r.LeadsTotal<span class="pz-cell-sub">@r.LeadsPendingReview pending review</span></td>
              <td><a class="pz-btn pz-btn-quiet" href="/admin/customers/@r.CustomerId">Manage →</a></td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </div>
</main>
  </div>
</div>
<partial name="/Pages/Shared/_ConfirmDialog.cshtml" />
<script src="~/js/app-rail.js" defer asp-append-version="true"></script>
<script src="~/js/app-confirm.js" defer asp-append-version="true"></script>
