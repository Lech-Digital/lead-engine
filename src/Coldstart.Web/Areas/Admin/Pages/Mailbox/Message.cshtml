@page "/admin/mailbox/{uid}"
@model Coldstart.Web.Areas.Admin.Pages.Mailbox.MessageModel
@{ ViewData["Title"] = "Message — Coldstart admin"; Layout = "/Pages/Shared/_Layout.cshtml"; ViewData["AdminTab"] = "mailbox"; var m = Model.Mail; }

<div class="rail-shell">
  <partial name="_AdminSidebar" />
  <div class="rail-main">
<main class="wrap app-zone">

  @if (Model.Unreachable)
  {
    <p class="mail-error">Mailbox unreachable right now — check the connection and try again.</p>
  }
  else if (m is not null)
  {
    <div class="pz-head">
      <div>
        <h1>@m.Subject</h1>
        <p class="pz-sub">Message from the shared inbox.</p>
      </div>
      <a class="pz-btn pz-btn-quiet" href="/admin/mailbox">← Inbox</a>
    </div>

    <div class="pz-card">
      <dl class="pz-facts">
        <div class="pz-fact"><dt>From</dt><dd>@(string.IsNullOrWhiteSpace(m.FromName) ? m.FromAddress : $"{m.FromName} <{m.FromAddress}>")</dd></div>
        <div class="pz-fact"><dt>To</dt><dd>@m.To</dd></div>
        <div class="pz-fact"><dt>Date</dt><dd class="ts">@m.Date.ToString("dd MMM yyyy · HH:mm", System.Globalization.CultureInfo.InvariantCulture)</dd></div>
      </dl>
      <div class="pz-actions">
        <a class="pz-btn pz-btn-primary" href="/admin/mailbox/compose?replyTo=@m.Uid">Reply</a>
        <form method="post" asp-page-handler="MarkUnread" asp-route-uid="@m.Uid"><button class="pz-btn pz-btn-quiet" type="submit">Mark unread</button></form>
        <span class="spacer"></span>
        <form method="post" asp-page-handler="Delete" asp-route-uid="@m.Uid">
          <button class="pz-btn pz-btn-danger" type="submit"
                  data-confirm="This permanently deletes &quot;@m.Subject&quot;."
                  data-confirm-title="Delete this message?" data-confirm-ok="Delete">Delete</button>
        </form>
      </div>
    </div>

    @if (m.HtmlBody is not null)
    {
      @if (m.RemoteImagesRemoved) { <p class="mail-note">Remote images were removed for your safety.</p> }
      <div class="mail-html">@Html.Raw(m.HtmlBody)</div>   @* sanitized in Infrastructure — see spec *@
    }
    else
    {
      <div class="mail-text">@m.TextBody</div>
    }

    @if (m.Attachments.Count > 0)
    {
      <div class="mail-attachments">
        @foreach (var a in m.Attachments)
        {
          <a class="app-link-out" href="/admin/mailbox/@m.Uid?handler=Attachment&index=@a.Index">📎 @a.FileName (@a.ContentType)</a>
        }
      </div>
    }
  }
</main>
  </div>
</div>
<partial name="/Pages/Shared/_ConfirmDialog.cshtml" />
<script src="~/js/app-rail.js" defer asp-append-version="true"></script>
<script src="~/js/app-confirm.js" defer asp-append-version="true"></script>
