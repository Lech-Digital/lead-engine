@{ var adminTab = (string?)ViewData["AdminTab"] ?? ""; }
<header class="app-bar">
  <a class="wordmark" href="/">coldstart<i>*</i></a>
  <nav class="app-nav">
    <a href="/app">Your briefing</a>
    <form method="post" asp-page="/Account/Logout" asp-area="Identity"><button class="btn btn-ghost" type="submit">Log out</button></form>
  </nav>
</header>

<div class="wrap" style="margin-top:14px;">
  <nav class="settings-nav" aria-label="Admin sections">
    <a href="/admin/cockpit" class="@(adminTab == "cockpit" ? "active" : null)">Cockpit</a>
    <a href="/admin" class="@(adminTab == "companies" ? "active" : null)">Companies &amp; invites</a>
    <a href="/admin/mailbox" class="@(adminTab == "mailbox" ? "active" : null)">Mailbox</a>
    <a href="/admin/exclusions" class="@(adminTab == "exclusions" ? "active" : null)">Exclusions</a>
    <a href="https://stats.getcoldstart.nl" target="_blank" rel="noopener">Visitors ↗</a>
    <a href="https://dashboard.stripe.com" target="_blank" rel="noopener">Stripe ↗</a>
  </nav>
</div>
<script>
  (function () {
    var KEY = "coldstart-admin-scroll";
    var saved = sessionStorage.getItem(KEY);
    if (saved !== null) { sessionStorage.removeItem(KEY); window.scrollTo(0, parseInt(saved, 10) || 0); }
    document.currentScript.previousElementSibling.addEventListener("click", function (e) {
      if (e.target.closest("a[href^='/admin']")) sessionStorage.setItem(KEY, String(window.scrollY));
    });
  })();
</script>
