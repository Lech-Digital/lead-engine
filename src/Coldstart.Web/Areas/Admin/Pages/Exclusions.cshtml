@page "/admin/exclusions"
@model Coldstart.Web.Areas.Admin.Pages.ExclusionsModel
@{ ViewData["Title"] = "Admin · Exclusions"; Layout = "/Pages/Shared/_Layout.cshtml"; ViewData["AdminTab"] = "exclusions"; }

<div class="rail-shell">
  <partial name="_AdminSidebar" />
  <div class="rail-main">
<main class="wrap app-zone">
  <div class="pz-head">
    <div>
      <h1>Exclusions</h1>
      <p class="pz-sub">Companies that objected to processing (GDPR art. 21) — anything matching a value here, case-insensitive, is skipped by every future harvest for every customer.</p>
    </div>
    <span class="pz-count">@Model.Rows.Count exclusion@(Model.Rows.Count == 1 ? "" : "s")</span>
  </div>

  @if (Model.StatusMessage is not null) { <p class="form-status">@Model.StatusMessage</p> }

  <div class="pz-card">
    <h2>Add an exclusion</h2>
    <form method="post" asp-page-handler="Add">
      <div class="pz-field">
        <label for="value">Company name or domain</label>
        <input type="text" name="value" id="value" placeholder="e.g. Acme BV or acme.nl" required minlength="3" maxlength="200">
      </div>
      <div class="pz-field">
        <label for="note">Note</label>
        <input type="text" name="note" id="note" placeholder="who objected, when">
      </div>
      <p class="pz-hint">Add the company name as it appears in the wild; add the domain as a second entry when you know it.</p>
      <div class="pz-actions"><button class="pz-btn pz-btn-primary" type="submit">Exclude</button></div>
    </form>
  </div>

  <div class="pz-card">
    <h2>Excluded</h2>
    @if (Model.Rows.Count == 0)
    {
      <p class="pz-empty">No exclusions yet. When an objection arrives at info@getcoldstart.nl, add it here the same day.</p>
    }
    else
    {
      <div class="pz-table-wrap">
        <table class="pz-table">
          <thead><tr><th>Value</th><th>Note</th><th>Added</th><th></th></tr></thead>
          <tbody>
          @foreach (var row in Model.Rows)
          {
            <tr>
              <td><code>@row.Value</code></td>
              <td>@row.Note</td>
              <td>@row.CreatedAt.ToString("d MMM yyyy")</td>
              <td>
                <form method="post" asp-page-handler="Remove">
                  <input type="hidden" name="id" value="@row.Id">
                  <button class="pz-btn pz-btn-danger" type="submit"
                          data-confirm="This lets &quot;@row.Value&quot; be contacted again by future harvests."
                          data-confirm-title="Remove this exclusion?" data-confirm-ok="Remove">Remove</button>
                </form>
              </td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </div>
</main>
  </div>
</div>
<partial name="/Pages/Shared/_ConfirmDialog.cshtml" />
<script src="~/js/app-rail.js" defer asp-append-version="true"></script>
<script src="~/js/app-confirm.js" defer asp-append-version="true"></script>
