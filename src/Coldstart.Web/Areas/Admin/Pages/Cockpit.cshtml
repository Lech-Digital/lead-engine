@page "/admin/cockpit"
@model Coldstart.Web.Areas.Admin.Pages.CockpitModel
@{ ViewData["Title"] = "Admin · Cockpit"; Layout = "/Pages/Shared/_Layout.cshtml"; ViewData["AdminTab"] = "cockpit"; }

<div class="rail-shell">
  <partial name="_AdminSidebar" />
  <div class="rail-main">
<main class="wrap app-zone">
  <div class="pz-head">
    <div>
      <h1>Cockpit</h1>
      <p class="pz-sub">Business vitals and per-customer engine health, last 7 days.</p>
    </div>
  </div>

  <div class="pz-card">
    <h2>Last 7 days</h2>
    <div class="pz-stats">
      <div class="pz-stat"><span class="pz-stat-num">@Model.PayingCustomers</span><span class="pz-stat-label">Paying customers</span></div>
      <div class="pz-stat"><span class="pz-stat-num">@Model.FoundThisWeek</span><span class="pz-stat-label">Leads found</span></div>
      <div class="pz-stat"><span class="pz-stat-num">@Model.SentThisWeek</span><span class="pz-stat-label">Emails sent</span></div>
      <div class="pz-stat"><span class="pz-stat-num">@Model.OutcomesThisWeek</span><span class="pz-stat-label">Outcomes</span></div>
      <div class="pz-stat"><span class="pz-stat-num">@Model.InquiriesThisWeek</span><span class="pz-stat-label">Inquiries</span></div>
      <div class="pz-stat"><span class="pz-stat-num">@Model.RunsThisWeek</span><span class="pz-stat-label">Engine runs</span><span class="pz-stat-sub">@Model.SignalsReadThisWeek signals read</span></div>
      <div class="pz-stat"><span class="pz-stat-num">@Model.Exclusions</span><span class="pz-stat-label">Exclusions</span></div>
    </div>
  </div>

  <div class="pz-card">
    <h2>Engine health per customer</h2>
    @if (Model.Customers.Count == 0)
    {
      <p class="pz-empty">No customers yet — invite one from Companies &amp; invites to see engine health here.</p>
    }
    else
    {
      <div class="pz-table-wrap">
        <table class="pz-table">
          <thead><tr>
            <th>Customer</th><th>Plan</th><th>Last harvest</th><th>Leads</th><th>Pending</th><th>Sent</th><th>Outcomes</th><th>Flags</th>
          </tr></thead>
          <tbody>
          @foreach (var row in Model.Customers)
          {
            <tr class="@(row.Alarm ? "pz-row-alarm" : null)">
              <td>@row.Name</td>
              <td><span class="pz-pill @(row.Plan == "Full" ? "pz-pill-yes" : "pz-pill-sent")">@row.Plan</span></td>
              <td>@row.HarvestStatus@(row.LastHarvestAt is { } at ? $" · {at:dd MMM HH:mm}" : "")</td>
              <td>@row.TotalLeads</td>
              <td>@row.PendingLeads</td>
              <td>@row.SentLeads</td>
              <td>@row.Outcomes</td>
              <td>
                @if (row.AlarmReason is { } reason) { <span class="pz-flag">⚠ @reason</span> }
                @if (row.RetentionDeadline is { } deadline) { <span class="pz-cell-sub">Delete by @deadline.ToString("dd MMM")</span> }
              </td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </div>
</main>
  </div>
</div>
<partial name="/Pages/Shared/_ConfirmDialog.cshtml" />
<script src="~/js/app-rail.js" defer asp-append-version="true"></script>
<script src="~/js/app-confirm.js" defer asp-append-version="true"></script>
