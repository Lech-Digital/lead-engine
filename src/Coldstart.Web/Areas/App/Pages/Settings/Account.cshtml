@page "/app/settings/account"
@model Coldstart.Web.Areas.App.Pages.Settings.AccountSettingsModel
@{ ViewData["Title"] = "Settings · Account"; Layout = "/Pages/Shared/_Layout.cshtml"; ViewData["AppNav"] = "account"; }

<div class="rail-shell">
  <partial name="_AppSidebar" />
  <div class="rail-main">
<main class="wrap app-zone settings-page">
  <div class="pz-head">
    <div>
      <h1>Account</h1>
      <p class="pz-sub">Your sign-in details and whether onboarding tips still show up.</p>
    </div>
  </div>

  <div class="pz-card" id="account">
    <h2>Account</h2>
    <dl class="pz-facts">
      <div class="pz-fact"><dt>Signed in as</dt><dd>@Model.SignedInEmail</dd></div>
    </dl>
    <div class="pz-actions">
      <a class="pz-btn pz-btn-quiet" href="/Identity/Account/ForgotPassword">Change password</a>
      <form method="post" asp-page="/Account/Logout" asp-area="Identity"><button class="pz-btn pz-btn-quiet" type="submit">Log out</button></form>
    </div>
  </div>

  <div class="pz-card" id="hints">
    <h2>Onboarding hints</h2>
    <p class="pz-hint">Want the getting-started tips again? They'll reappear one per day.</p>
    <form method="post" asp-page-handler="ShowHints">
      <div class="pz-actions">
        <button type="submit" class="pz-btn pz-btn-quiet">Show hints again</button>
        @if (Model.StatusMessage is not null) { <span class="form-status">@Model.StatusMessage</span> }
      </div>
    </form>
  </div>
</main>
  </div>
</div>
<partial name="/Pages/Shared/_ConfirmDialog.cshtml" />
<script src="~/js/app-rail.js" defer asp-append-version="true"></script>
<script src="~/js/app-confirm.js" defer asp-append-version="true"></script>
