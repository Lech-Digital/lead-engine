@page "/app/settings/company"
@model Coldstart.Web.Areas.App.Pages.Settings.CompanySettingsModel
@{ ViewData["Title"] = "Settings · Company"; Layout = "/Pages/Shared/_Layout.cshtml"; ViewData["AppNav"] = "company"; }

<div class="rail-shell">
  <partial name="_AppSidebar" />
  <div class="rail-main">
<main class="wrap app-zone settings-page">
  <div class="pz-head">
    <div>
      <h1>Company</h1>
      <p class="pz-sub">Your niche steers what the engine hunts for; the rest is your registration record.</p>
    </div>
  </div>

  <form method="post">
    <div class="pz-card">
      <h2>Company</h2>
      <div class="pz-settings">
        <div class="pz-field"><label asp-for="Input.CompanyName">Company name</label><input asp-for="Input.CompanyName"></div>
        <div class="pz-field"><label asp-for="Input.Website">Website</label><input asp-for="Input.Website"></div>
        <div class="pz-field"><label asp-for="Input.Niche">Niche</label><input asp-for="Input.Niche"></div>
        <div class="pz-field"><label asp-for="Input.ContactEmail">Contact email</label><input asp-for="Input.ContactEmail" type="email"></div>
      </div>
    </div>
    <div class="pz-card">
      <h2>Registration</h2>
      <div class="pz-settings">
        <div class="pz-field full"><label asp-for="Input.Address">Address</label><input asp-for="Input.Address"></div>
        <div class="pz-field"><label asp-for="Input.VatNumber">VAT number</label><input asp-for="Input.VatNumber"></div>
        <div class="pz-field"><label asp-for="Input.KvkNumber">KvK number</label><input asp-for="Input.KvkNumber"></div>
      </div>
      <div class="pz-actions">
        <button class="pz-btn pz-btn-primary" type="submit">Save changes</button>
        @if (Model.StatusMessage is not null) { <span class="form-status">@Model.StatusMessage</span> }
      </div>
    </div>
  </form>
</main>
  </div>
</div>
<partial name="/Pages/Shared/_ConfirmDialog.cshtml" />
<script src="~/js/app-rail.js" defer asp-append-version="true"></script>
<script src="~/js/app-confirm.js" defer asp-append-version="true"></script>
