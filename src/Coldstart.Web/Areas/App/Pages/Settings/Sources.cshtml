@page "/app/settings/sources"
@model Coldstart.Web.Areas.App.Pages.Settings.SourcesSettingsModel
@{ ViewData["Title"] = "Settings · Sources"; Layout = "/Pages/Shared/_Layout.cshtml"; ViewData["SettingsTab"] = "sources"; }

<partial name="_SettingsHeader" />
<main class="wrap app-zone settings-page">
  <section class="app-briefing"><h1>Settings</h1></section>
  <partial name="_SettingsNav" />

  <form method="post">
    <section class="panel">
      <h2 class="app-group-head">Where the engine hunts</h2>
      <p class="settings-note">Pick the signal sources for your niche — the nightly run searches only what you keep on.</p>
      @for (var i = 0; i < Model.Sources.Count; i++)
      {
        <div class="source-row">
          <label>
            <input type="checkbox" asp-for="Sources[i].Enabled">
            <input type="hidden" asp-for="Sources[i].Name">
            <span class="source-title">@Model.Sources[i].Title</span>
            <span class="source-desc">@Model.Sources[i].Description</span>
          </label>
        </div>
      }
    </section>
    <div class="profile-actions">
      <button class="btn btn-primary" type="submit">Save →</button>
      @if (Model.StatusMessage is not null) { <span class="form-status">@Model.StatusMessage</span> }
    </div>
  </form>
</main>
