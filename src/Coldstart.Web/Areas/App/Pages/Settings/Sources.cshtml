@page "/app/settings/sources"
@model Coldstart.Web.Areas.App.Pages.Settings.SourcesSettingsModel
@{ ViewData["Title"] = "Settings · Sources"; Layout = "/Pages/Shared/_Layout.cshtml"; ViewData["AppNav"] = "sources"; }

<div class="rail-shell">
  <partial name="_AppSidebar" />
  <div class="rail-main">
<main class="wrap app-zone settings-page">
  <section class="app-briefing"><h1>Settings</h1></section>

  <form method="post">
    <section class="panel">
      <h2 class="app-group-head">Where the engine hunts</h2>
      <p class="settings-note">Pick the signal sources for your niche — the nightly run searches only what you keep on.</p>
      @for (var i = 0; i < Model.Sources.Count; i++)
      {
        <div class="source-row">
          <label>
            <input type="checkbox" asp-for="Sources[i].Enabled">
            <input type="hidden" asp-for="Sources[i].Name">
            <span class="source-title">@Model.Sources[i].Title</span>
            <span class="source-desc">@Model.Sources[i].Description</span>
          </label>
        </div>
      }
    </section>
    <div class="profile-actions">
      <button class="btn btn-primary" type="submit">Save →</button>
      @if (Model.StatusMessage is not null) { <span class="form-status">@Model.StatusMessage</span> }
    </div>
  </form>

  <form method="post" asp-page-handler="Wish">
    <section class="panel">
      <h2 class="app-group-head">Missing something?</h2>
      <p class="settings-note">A source we should hunt, a feature you wish existed — say it here and it goes straight to the founder, not into a ticket queue.</p>
      <textarea name="wish" rows="3" minlength="3" maxlength="2000" required
                placeholder="e.g. Belgian job boards, LinkedIn company announcements, a weekly summary email…"
                style="width:100%;resize:vertical;"></textarea>
      <div class="profile-actions" style="margin-top:10px;">
        <button class="btn btn-ghost" type="submit">Send wish →</button>
      </div>
    </section>
  </form>
</main>
  </div>
</div>
<partial name="/Pages/Shared/_ConfirmDialog.cshtml" />
<script src="~/js/app-rail.js" defer asp-append-version="true"></script>
<script src="~/js/app-confirm.js" defer asp-append-version="true"></script>
