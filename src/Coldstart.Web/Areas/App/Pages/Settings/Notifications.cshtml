@page "/app/settings/notifications"
@model Coldstart.Web.Areas.App.Pages.Settings.NotificationsSettingsModel
@{ ViewData["Title"] = "Settings · Notifications"; Layout = "/Pages/Shared/_Layout.cshtml"; ViewData["AppNav"] = "notifications"; }

<div class="rail-shell">
  <partial name="_AppSidebar" />
  <div class="rail-main">
<main class="wrap app-zone settings-page">
  <section class="app-briefing"><h1>Settings</h1></section>

  <form method="post">
    <section class="panel" id="notifications">
      <h2 class="app-group-head">Notifications</h2>
      <p class="settings-note">Your morning briefing always arrives by <strong>email</strong> to your account address. Add a push channel below if you want it faster.</p>
      <div class="field">
        <label asp-for="SlackWebhookUrl">Slack webhook URL <span class="field-hint">— Slack → Apps → Incoming Webhooks → Add to channel, then paste the URL here</span></label>
        <input asp-for="SlackWebhookUrl" placeholder="https://hooks.slack.com/services/…">
      </div>
      @if (User.IsInRole(Coldstart.Web.ColdstartRoles.SuperAdmin))
      {
        <div class="field">
          <label asp-for="WhatsAppNumber">WhatsApp number <span class="field-hint">— operator only (sandbox) until the paid Twilio account exists</span></label>
          <input asp-for="WhatsAppNumber" placeholder="+31 6 12345678">
        </div>
      }
      <div class="settings-actions">
        <button class="btn btn-primary" type="submit">Save →</button>
        <button class="btn btn-ghost" type="submit" asp-page-handler="TestSlack">Send Slack test</button>
        @if (User.IsInRole(Coldstart.Web.ColdstartRoles.SuperAdmin))
        {
          <button class="btn btn-ghost" type="submit" asp-page-handler="TestWhatsApp">Send WhatsApp test</button>
        }
        @if (Model.StatusMessage is not null) { <span class="form-status">@Model.StatusMessage</span> }
      </div>
    </section>
  </form>
</main>
  </div>
</div>
<partial name="/Pages/Shared/_ConfirmDialog.cshtml" />
<script src="~/js/app-rail.js" defer asp-append-version="true"></script>
<script src="~/js/app-confirm.js" defer asp-append-version="true"></script>
