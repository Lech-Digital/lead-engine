@page "/app"
@model Coldstart.Web.Areas.App.Pages.IndexModel
@using Coldstart.Web.Areas.App.Pages
@{
    ViewData["Title"] = "Your morning briefing";
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["AppNav"] = "briefing";
}

<div class="rail-shell">
  <partial name="_AppSidebar" />
  <div class="rail-main">
<main class="wrap app-zone">
  <div class="pz-head">
    <div>
      @if (Model.TotalLeads == 0 && Model.HarvestStatus is Coldstart.Domain.HarvestStatus.Pending or Coldstart.Domain.HarvestStatus.Running)
      {
        <h1>Finding your first leads…</h1>
      }
      else if (Model.TotalLeads == 0 && Model.HarvestStatus == Coldstart.Domain.HarvestStatus.Failed)
      {
        <h1>We couldn't fetch leads yet</h1>
      }
      else if (Model.OvernightCount > 0)
      {
        <h1>Good morning — @Model.OvernightCount found overnight</h1>
      }
      else
      {
        <h1>Good morning — no new leads this morning</h1>
      }
      @{
        var statParts = new List<string>();
        if (Model.LatestFound is { } latest) { statParts.Add($"latest <b>{latest.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)}</b> UTC"); }
        if (Model.SentTodayCount > 0) { statParts.Add($"<b>{Model.SentTodayCount}</b> sent today"); }
        if (Model.HistoryCount > 0) { statParts.Add($"<b>{Model.HistoryCount}</b> in history"); }
      }
      @if (statParts.Count > 0)
      {
        <p class="pz-sub">@Html.Raw(string.Join(" · ", statParts))</p>
      }
    </div>
    @if (Model.Queue.Count > 0)
    {
      <a class="pz-btn pz-btn-primary" href="/app/leads/@Model.Queue[0].Id?run=1">Review all →</a>
    }
  </div>

  @if (!string.IsNullOrEmpty(Model.StatusMessage))
  {
    <aside class="app-explainer"><p>@Model.StatusMessage</p></aside>
  }

  @if (Model.ActiveHint is { } hint)
  {
    <aside class="app-explainer" id="app-explainer">
      <p>@hint.Body</p>
      <form method="post" asp-page-handler="DismissHint">
        <input type="hidden" name="key" value="@hint.Key">
        <button type="submit" class="app-explainer-x" aria-label="Dismiss">Got it</button>
      </form>
    </aside>
  }

  @if (Model.Queue.Count == 0)
  {
    <p class="app-group-empty">Nothing to review yet — the engine hunts again tonight.</p>
  }
  else
  {
    <div class="pz-queue">
      @foreach (var lead in Model.Queue)
      {
        @if (lead.Locked)
        {
          <div class="lead-row-wrap">
            <div class="lead-row locked" onclick="document.getElementById('upgrade').showModal()">
              <div class="lead-row-main">
                <div class="lead-row-head">
                  <span class="lead-row-co">@lead.Company</span>
                  <span class="pz-pill @FitLabel.PillClass(lead.Fit)">@FitLabel.Text(lead.Fit)</span>
                  @if (!string.IsNullOrWhiteSpace(lead.MatchedSignals))
                  {
                    <span class="lead-row-why">⚡ @lead.MatchedSignals.Split(',')[0].Trim()</span>
                  }
                </div>
                <div class="lead-row-subj">@lead.Subject</div>
              </div>
              <span class="cz-lock">🔒 Unlock</span>
            </div>
          </div>
        }
        else
        {
          <a class="pz-lead" href="/app/leads/@lead.Id">
            <div>
              <div class="pz-lead-meta">
                <span class="pz-lead-co">@lead.Company</span>
                <span class="pz-pill @FitLabel.PillClass(lead.Fit)">@FitLabel.Text(lead.Fit)</span>
                @if (!string.IsNullOrWhiteSpace(lead.MatchedSignals))
                {
                  <span class="pz-why">⚡ @lead.MatchedSignals.Split(',')[0].Trim()</span>
                }
              </div>
              <p class="pz-lead-subj">@lead.Subject</p>
            </div>
            <div class="pz-row-actions">
              <form method="post" asp-page-handler="Skip">
                <input type="hidden" name="id" value="@lead.Id">
                <button class="pz-skip" type="submit" title="Skip" aria-label="Skip @lead.Company"
                        data-confirm="It moves to History under “Skipped” — you can reopen it anytime."
                        data-confirm-title="Skip @lead.Company?" data-confirm-ok="Skip lead">✕</button>
              </form>
            </div>
          </a>
        }
      }
    </div>
  }

  @if (Model.OlderUnreviewedCount > 0)
  {
    <p class="cz-older">+ @Model.OlderUnreviewedCount older @(Model.OlderUnreviewedCount == 1 ? "lead" : "leads") waiting · <a href="/app/history">see them in History →</a></p>
  }

  @if (Model.QuietSentCount > 0)
  {
    <p class="cz-older">🔕 @Model.QuietSentCount sent @(Model.QuietSentCount == 1 ? "email has" : "emails have") gone quiet — a follow-up bump is ready on each · <a href="/app/history?filter=sent">open them →</a></p>
  }

  @if (Model.LockedCount > 0)
  {
    <div class="app-foil">
      <p>@Model.LockedCount more @(Model.LockedCount == 1 ? "lead" : "leads") behind your plan.</p>
      <div class="cz-foilcta">
        <form method="post" asp-page="/Billing" asp-area="App" asp-page-handler="Checkout">
          <partial name="_CurrencyPicker" model='"foil"' />
          <button class="btn btn-primary" type="submit">Unlock all @Model.LockedCount @(Model.LockedCount == 1 ? "lead" : "leads")</button>
        </form>
      </div>
    </div>
  }

  <dialog id="upgrade" class="lead-modal" aria-labelledby="upgrade-title">
    <div class="lead-modal-card">
      <p class="lead-modal-eyebrow">Free plan</p>
      <h2 class="lead-modal-title" id="upgrade-title">Unlock every lead</h2>
      <p class="lead-modal-detail">Your free plan shows a sample. The Full plan gives you every lead we find, every morning.</p>
      <div class="lead-modal-actions">
        <form method="post" asp-page="/Billing" asp-area="App" asp-page-handler="Checkout">
          <partial name="_CurrencyPicker" model='"modal"' />
          <button class="btn btn-primary" type="submit" autofocus>Subscribe — unlock every lead</button>
        </form>
        <form method="dialog"><button class="btn btn-ghost" value="cancel">Not now</button></form>
      </div>
    </div>
  </dialog>
</main>
  </div>
</div>
<partial name="/Pages/Shared/_ConfirmDialog.cshtml" />
<script src="~/js/app-rail.js" defer asp-append-version="true"></script>
<script src="~/js/app-confirm.js" defer asp-append-version="true"></script>
