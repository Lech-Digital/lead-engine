@page "/app"
@model Coldstart.Web.Areas.App.Pages.IndexModel
@{
    ViewData["Title"] = "Your morning briefing";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<header class="app-bar">
  <a class="wordmark" href="/">coldstart<i>*</i></a>
  <nav class="app-nav">
    <a href="/app/profile">Company profile</a>
    <form method="post" asp-page="/Account/Logout" asp-area="Identity"><button class="btn btn-ghost" type="submit">Log out</button></form>
  </nav>
</header>

<main class="wrap app-zone">
  @Html.AntiForgeryToken()

  <div class="cz-greet">
    @if (Model.TotalLeads == 0 && Model.HarvestStatus is Coldstart.Domain.HarvestStatus.Pending or Coldstart.Domain.HarvestStatus.Running)
    {
      <h1>Finding your first leads…</h1>
    }
    else if (Model.TotalLeads == 0 && Model.HarvestStatus == Coldstart.Domain.HarvestStatus.Failed)
    {
      <h1>We couldn't fetch leads yet</h1>
    }
    else if (Model.OvernightCount > 0)
    {
      <h1>Good morning — @Model.OvernightCount found overnight</h1>
    }
    else
    {
      <h1>Good morning — no new leads this morning</h1>
    }
    @if (Model.Queue.Count > 0)
    {
      <a class="btn btn-primary" href="/app/leads/@Model.Queue[0].Id?run=1">Review all →</a>
    }
  </div>

  @{
    var statParts = new List<string>();
    if (Model.LatestFound is { } latest) { statParts.Add($"latest <b>{latest.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)}</b> UTC"); }
    if (Model.SentTodayCount > 0) { statParts.Add($"<b>{Model.SentTodayCount}</b> sent today"); }
    if (Model.HistoryCount > 0) { statParts.Add($"<b>{Model.HistoryCount}</b> in history"); }
  }
  @if (statParts.Count > 0)
  {
    <p class="cz-stat">@Html.Raw(string.Join(" · ", statParts))</p>
  }

  @if (Model.ActiveHint is { } hint)
  {
    <aside class="app-explainer" id="app-explainer">
      <p>@hint.Body</p>
      <form method="post" asp-page-handler="DismissHint">
        <input type="hidden" name="key" value="@hint.Key">
        <button type="submit" class="app-explainer-x" aria-label="Dismiss">Got it</button>
      </form>
    </aside>
  }

  <section class="app-profile">
    @if (Model.Profile.IsEmpty)
    {
      <div class="app-profile-empty">
        <div><strong>Add your company details</strong><p>Address, VAT, KvK, niche — shown on your account.</p></div>
        <a class="btn btn-primary" href="/app/profile">Add details →</a>
      </div>
    }
    else
    {
      <div class="app-profile-card">
        <h2>@(string.IsNullOrWhiteSpace(Model.Profile.CompanyName) ? Model.CustomerName : Model.Profile.CompanyName)</h2>
        <dl>
          @if (!string.IsNullOrWhiteSpace(Model.Profile.Address)) { <div><dt>Address</dt><dd>@Model.Profile.Address</dd></div> }
          @if (!string.IsNullOrWhiteSpace(Model.Profile.VatNumber)) { <div><dt>VAT</dt><dd>@Model.Profile.VatNumber</dd></div> }
          @if (!string.IsNullOrWhiteSpace(Model.Profile.KvkNumber)) { <div><dt>KvK</dt><dd>@Model.Profile.KvkNumber</dd></div> }
          @if (!string.IsNullOrWhiteSpace(Model.Profile.Niche)) { <div><dt>Niche</dt><dd>@Model.Profile.Niche</dd></div> }
          @if (!string.IsNullOrWhiteSpace(Model.Profile.Website)) { <div><dt>Website</dt><dd>@Model.Profile.Website</dd></div> }
          @if (!string.IsNullOrWhiteSpace(Model.Profile.ContactEmail)) { <div><dt>Contact</dt><dd>@Model.Profile.ContactEmail</dd></div> }
        </dl>
        <a class="app-edit-link" href="/app/profile">Edit</a>
      </div>
    }
  </section>

  <p class="app-sub">@Model.CustomerName</p>

  @if (Model.Queue.Count == 0)
  {
    <p class="app-group-empty">Nothing to review yet — the engine hunts again tonight.</p>
  }
  else
  {
    <div class="cz-list">
      @foreach (var lead in Model.Queue)
      {
        @if (lead.Locked)
        {
          <div class="lead-row-wrap">
            <div class="lead-row locked" onclick="document.getElementById('upgrade').showModal()">
              <div class="lead-row-main">
                <div class="lead-row-head">
                  <span class="lead-row-co">@lead.Company</span>
                  <span class="fit fit-@lead.Fit.ToLower()">@lead.Fit</span>
                  @if (!string.IsNullOrWhiteSpace(lead.MatchedSignals))
                  {
                    <span class="lead-row-why">⚡ @lead.MatchedSignals.Split(',')[0].Trim()</span>
                  }
                </div>
                <div class="lead-row-subj">@lead.Subject</div>
              </div>
              <span class="cz-lock">🔒 Unlock</span>
            </div>
          </div>
        }
        else
        {
          <div class="lead-row-wrap">
            <a class="lead-row" href="/app/leads/@lead.Id">
              <div class="lead-row-main">
                <div class="lead-row-head">
                  <span class="lead-row-co">@lead.Company</span>
                  <span class="fit fit-@lead.Fit.ToLower()">@lead.Fit</span>
                  @if (!string.IsNullOrWhiteSpace(lead.MatchedSignals))
                  {
                    <span class="lead-row-why">⚡ @lead.MatchedSignals.Split(',')[0].Trim()</span>
                  }
                </div>
                <div class="lead-row-subj">@lead.Subject</div>
              </div>
            </a>
            <form method="post" asp-page-handler="Skip" class="lead-skip-form">
              <input type="hidden" name="id" value="@lead.Id">
              <button class="cz-skip" type="submit" title="Skip">✕</button>
            </form>
          </div>
        }
      }
    </div>
  }

  @if (Model.OlderUnreviewedCount > 0)
  {
    <p class="cz-older">+ @Model.OlderUnreviewedCount older @(Model.OlderUnreviewedCount == 1 ? "lead" : "leads") waiting · <a href="/app/history">see them in History →</a></p>
  }

  @if (Model.LockedCount > 0)
  {
    <div class="app-foil">
      <p>@Model.LockedCount more @(Model.LockedCount == 1 ? "lead" : "leads") behind your plan.</p>
      <div class="cz-foilcta">
        <button class="btn btn-primary" type="button" onclick="document.getElementById('upgrade').showModal()">Unlock all @Model.LockedCount @(Model.LockedCount == 1 ? "lead" : "leads")</button>
      </div>
    </div>
  }

  <dialog id="move-error" class="lead-modal" aria-labelledby="move-error-title">
    <form method="dialog" class="lead-modal-card">
      <p class="lead-modal-eyebrow">Move blocked</p>
      <h2 class="lead-modal-title" id="move-error-title">Couldn't move that lead</h2>
      <p class="lead-modal-detail" id="move-error-detail"></p>
      <div class="lead-modal-actions"><button class="btn btn-primary" value="ok" autofocus>Got it</button></div>
    </form>
  </dialog>

  <dialog id="upgrade" class="lead-modal" aria-labelledby="upgrade-title">
    <form method="dialog" class="lead-modal-card">
      <p class="lead-modal-eyebrow">Free plan</p>
      <h2 class="lead-modal-title" id="upgrade-title">Unlock every lead</h2>
      <p class="lead-modal-detail">Your free plan shows a sample. To see and send every lead we find, upgrade your plan — email <a href="mailto:andrzej@getcoldstart.nl">andrzej@getcoldstart.nl</a> and we'll set it up. (Self-serve subscriptions are coming soon.)</p>
      <div class="lead-modal-actions"><button class="btn btn-primary" value="ok" autofocus>Got it</button></div>
    </form>
  </dialog>
</main>
<script src="~/js/app-leads.js" defer></script>
